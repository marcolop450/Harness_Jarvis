{
  "mcpServers": {
    "fetch": {
      "command": "${python}",
      "args": [
        "-m",
        "mcp_server_fetch"
      ],
      "allowed_tools": [
        "fetch"
      ],
      "timeout_seconds": 30
    },
    "git": {
      "command": "${python}",
      "args": [
        "-m",
        "mcp_server_git",
        "--repository",
        "${workspace}"
      ],
      "allowed_tools": [
        "git_status",
        "git_log",
        "git_diff_unstaged",
        "git_diff_staged"
      ],
      "timeout_seconds": 30
    },
    "filesystem": {
      "command": "${node}",
      "args": [
        "${project}/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js",
        "${workspace}"
      ],
      "allowed_tools": [
        "read_text_file",
        "read_multiple_files",
        "list_directory",
        "search_files",
        "write_file",
        "edit_file"
      ],
      "timeout_seconds": 30
    }
  }
}
